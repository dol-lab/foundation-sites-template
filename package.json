{
	"name": "@dol-lab/foundation-sites-template",
	"version": "1.1.1",
	"description": "Themeable fork of Foundation for Sites 6: Sass source and the built app.css / app-backend.css.",
	"main": "gulpfile.js",
	"packageManager": "bun@1.3.8",
	"scripts": {
		"start": "gulp",
		"build": "gulp sass",
		"build:html": "bun build-html.js",
		"shots": "bun build-html.js && bun shots.js",
		"check": "bun check.js",
		"css-diff": "bun css-diff.js",
		"probe": "bun build-html.js > /dev/null && bun probe.js",
		"outline": "bun outline.js",
		"lint": "stylelint '**/*.scss' && prettier --check '*.js' 'js/*.js' 'lib/*.js'",
		"lint:fix": "stylelint '**/*.scss' --fix && prettier --write '*.js' 'js/*.js' 'lib/*.js'",
		"format": "prettier --write '*.js' 'js/*.js' 'lib/*.js'"
	},
	"author": "dol-lab",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/dol-lab/foundation-sites-template/issues"
	},
	"engines": {
		"bun": ">=1.3",
		"node": ">=18.0"
	},
	"dependencies": {
		"what-input": "^5.2.12"
	},
	"devDependencies": {
		"@stylistic/stylelint-plugin": "^4.0.1",
		"browser-sync": "^3.0.4",
		"gulp": "^5.0.1",
		"gulp-plumber": "^1.2.1",
		"marked": "^18.0.4",
		"sass-embedded": "^1.92.1",
		"stylelint": "^16.24.0",
		"stylelint-config-standard-scss": "^16",
		"stylelint-scss": "^6.14.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/dol-lab/foundation-sites-template.git"
	},
	"private": true
}
